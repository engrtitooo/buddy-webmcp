# Server-side only. Never expose provider secrets in VITE_* variables or the extension bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional Realtime overrides. OPENAI_API_KEY remains the only provider secret.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
PORT=8787
HOST=127.0.0.1
# Comma-separated exact origins. Add chrome-extension://EXTENSION_ID after loading the extension.
ALLOWED_ORIGINS=http://localhost:5173
# Local/private default: allowlist. The public judging service explicitly uses chrome-extensions.
BUDDY_EXTENSION_ORIGIN_POLICY=allowlist
ALLOW_ORIGINLESS=false
BUDDY_RATE_LIMIT_MAX=30
BUDDY_RATE_LIMIT_WINDOW_MS=60000
BUDDY_PROVIDER_TIMEOUT_MS=20000
BUDDY_REALTIME_MAX_SESSION_SECONDS=900
BUDDY_REALTIME_SESSION_RATE_LIMIT=10
# Optional auth-ready server control. Prefer a real gateway identity for public deployments.
BUDDY_API_AUTH_TOKEN=

# Build-time extension setting. Development defaults to http://127.0.0.1:8787.
# Production defaults to https://buddy-mcp-production.up.railway.app.
# Leave blank for mode defaults; an override must be HTTPS and non-loopback in production.
BUDDY_API_BASE_URL=
