{
  "name": "buddy-webmcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Buddy is the friendly interface for the agentic web.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @buddy/playground",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.35.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
